<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TJC Centenary Concert 海報產生器 - 四區傳教史版</title>
    <!-- 載入 Tailwind CSS 進行快速排版 -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 載入 html2canvas 用於將 HTML 轉換為圖片 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <!-- 載入 Google 字體 (思源宋體) -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            navy: '#0B132B',
                            gold: '#D4AF37',
                            light: '#F8F9FA'
                        }
                    },
                    fontFamily: {
                        serif: ['"Noto Serif TC"', 'serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        body {
            background-color: #e5e7eb;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 2rem 1rem;
            font-family: 'Noto Serif TC', serif;
        }
        
        /* 鎖定 A4 比例 */
        .poster-wrapper {
            width: 100%;
            max-width: 794px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            margin-bottom: 2rem;
            background: white;
            transition: all 0.3s ease;
        }

        #poster {
            width: 794px;
            height: 1123px;
            position: relative;
            background: linear-gradient(135deg, #0B132B 0%, #1A2A5C 100%);
            color: white;
            overflow: hidden;
        }

        .poster-border {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            bottom: 20px;
            border: 2px solid rgba(212, 175, 55, 0.3);
            pointer-events: none;
            z-index: 10;
        }

        .photo-frame {
            border: 2px solid #D4AF37;
            padding: 6px;
            background: rgba(255,255,255,0.1);
        }
        
        /* 隱藏捲軸但允許捲動 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body>

    <div class="mb-6 flex flex-col items-center gap-4 bg-white p-6 rounded-xl shadow-lg w-full max-w-3xl">
        <h1 class="text-2xl font-bold text-gray-800">西區傳教史海報 - 四區生成工具</h1>
        <p class="text-gray-600 text-sm text-center">
            請在下方切換牧區預覽。您好不容易生成的「教會座標」，請貼入下方 JS 的 `zonesData` 中。<br>
            完成後點擊下載按鈕，即可分別匯出四張海報。
        </p>
        
        <!-- 牧區切換按鈕 -->
        <div class="flex flex-wrap justify-center gap-3 w-full my-2" id="zone-buttons">
            <!-- 按鈕由 JS 動態生成並管理狀態 -->
        </div>

        <button onclick="downloadPoster()" class="bg-brand-gold hover:bg-yellow-600 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-transform transform hover:scale-105 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3px 0 003 3h10a3 3px 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            下載當前海報 (PNG)
        </button>
        <div id="status-msg" class="hidden text-brand-navy font-bold p-2 bg-yellow-100 rounded w-full text-center">圖片生成中，請稍候...</div>
    </div>

    <div class="poster-wrapper">
        <div id="poster">
            <div class="poster-border"></div>
            
            <!-- 背景裝飾光暈 -->
            <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(ellipse_at_top,rgba(212,175,55,0.15)_0%,transparent_50%)] pointer-events-none z-0"></div>
            
            <!-- 頂部標題區 (不變) -->
            <div class="pt-16 px-16 text-center relative z-20">
                <p class="text-brand-gold tracking-widest text-lg mb-2">TRUE JESUS CHURCH</p>
                <h1 class="text-6xl font-black mb-4 tracking-wider" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">百年紀念音樂會</h1>
                <!-- 動態牧區標題 -->
                <div class="inline-block border-b-2 border-brand-gold pb-2 mb-8">
                    <h2 class="text-4xl font-semibold text-brand-light tracking-widest">西區傳教史 — <span id="display-zone-title" class="text-brand-gold">復興區</span></h2>
                </div>
            </div>

            <!-- 動態內容區 (照片 + 教會座標列表) -->
            <div class="px-16 flex flex-col gap-8 relative z-20" style="height: 650px;">
                <!-- 該區代表性歷史照片 -->
                <div class="w-full flex justify-center">
                    <div class="photo-frame w-full max-w-2xl aspect-[21/9] relative overflow-hidden">
                        <img id="display-zone-img" src="https://placehold.co/1200x500/1e293b/d4af37?text=Fuxing+History+Photo" alt="牧區歷史照片" class="w-full h-full object-cover">
                    </div>
                </div>

                <!-- 教會與座標列表區 -->
                <div class="w-full">
                    <h3 class="text-xl text-brand-gold mb-4 tracking-widest flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3px 0 11-6 0 3 3px 0 016 0z" />
                        </svg>
                        牧區所屬教會與座標
                    </h3>
                    <!-- 座標列表容器 -->
                    <div id="display-zone-churches" class="grid grid-cols-2 gap-x-8 gap-y-4 text-gray-200">
                        <!-- 由 JS 動態注入 -->
                    </div>
                </div>
            </div>

            <!-- 底部資訊區 (不變) -->
            <div class="absolute bottom-12 w-full px-16 flex justify-between items-end z-20">
                <div class="text-left flex-1 border-l-4 border-brand-gold pl-4">
                    <p class="text-brand-gold text-2xl font-bold mb-2 tracking-wider">2026.11.15 (日) 14:00</p>
                    <p class="text-xl text-gray-200 mb-1">地點：國家音樂廳 (暫定)</p>
                    <p class="text-sm text-gray-400">主辦單位：真耶穌教會</p>
                </div>
                
                <div class="flex flex-col items-center ml-4">
                    <div class="p-2 bg-white rounded shadow-lg">
                        <img src="https://placehold.co/100x100/fff/000?text=QR+Code" alt="QR Code" class="w-20 h-20">
                    </div>
                    <p class="text-xs text-brand-gold mt-2 tracking-widest font-bold">掃描索票</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ==========================================
        // 【重要】請將您辛苦生成的「教會名稱與座標」貼在下方對應的陣列中
        // ==========================================
        const districtData = {
       fuxing: {
                name: "復興小區",
                id: "fuxing",
                churches: [
                    { name: "八德教會", lat: 24.934632, lng: 121.299978, photo: "assets/photos/fuxing/bade.jpg", showPhoto: true },
                    { name: "崎頂教會", lat: 24.900432, lng: 121.282682, photo: "assets/photos/fuxing/qiding.jpg", showPhoto: true },
                    { name: "大溪教會", lat: 24.881231, lng: 121.294548, photo: "assets/photos/fuxing/daxi.jpg", showPhoto: true },
                    { name: "復興教會", lat: 24.826416, lng: 121.356914, photo: "assets/photos/fuxing/fuxing.jpg", showPhoto: true },
                    { name: "義盛教會", lat: 24.779475, lng: 121.365940, photo: "assets/photos/fuxing/yisheng.jpg", showPhoto: true },
                    { name: "大灣祈禱所", lat: 24.760693, lng: 121.344903, photo: "assets/photos/fuxing/dawan.jpg", showPhoto: true },
                    { name: "雪霧鬧祈禱所", lat: 24.741287, lng: 121.365961, photo: "assets/photos/fuxing/xuewunao.jpg", showPhoto: true },
                    { name: "上巴陵教會", lat: 24.685697, lng: 121.396455, photo: "assets/photos/fuxing/shangbaling.jpg", showPhoto: true },
                    { name: "中巴陵", lat: 24.679721, lng: 121.396892, showPhoto: false },
                    { name: "三光", lat: 24.675178, lng: 121.366111, showPhoto: false },
                    { name: "光華", lat: 24.665251, lng: 121.398561, showPhoto: false }
                ]
            },
            zhumiao: {
                name: "竹苗小區",
                id: "zhumiao",
                churches: [
                    { name: "花園教會", lat: 24.645038, lng: 121.151893, photo: "assets/photos/zhumiao/huayuan.jpg", showPhoto: true },
                    { name: "五峰教會", lat: 24.629047, lng: 121.119750, photo: "assets/photos/zhumiao/wufeng.jpg", showPhoto: true },
                    { name: "桃山教會", lat: 24.599219, lng: 121.109834, photo: "assets/photos/zhumiao/taoshan.jpg", showPhoto: true },
                    { name: "清泉教會", lat: 24.578934, lng: 121.106060, photo: "assets/photos/zhumiao/qingquan.jpg", showPhoto: true },
                    { name: "義興教會", lat: 24.683555, lng: 121.185258, photo: "assets/photos/zhumiao/yixing.jpg", showPhoto: true },
                    { name: "錦屏教會", lat: 24.695765, lng: 121.227790, photo: "assets/photos/zhumiao/jinping.jpg", showPhoto: true },
                    { name: "尖石教會", lat: 24.720930, lng: 121.214883, photo: "assets/photos/zhumiao/jianshi.jpg", showPhoto: true }
                ]
            },
            zhongmiao: {
                name: "中苗小區",
                id: "zhongmiao",
                churches: [
                    { name: "東勢教會", lat: 24.249405, lng: 120.832019, photo: "assets/photos/zhongmiao/dongshi.jpg", showPhoto: true },
                    { name: "自由教會", lat: 24.270630, lng: 120.890200, photo: "assets/photos/zhongmiao/ziyou.jpg", showPhoto: true },
                    { name: "雙崎教會", lat: 24.290980, lng: 120.908350, photo: "assets/photos/zhongmiao/shuangqi.jpg", showPhoto: true },
                    { name: "達觀教會", lat: 24.321900, lng: 120.921956, photo: "assets/photos/zhongmiao/daguan.jpg", showPhoto: true },
                    { name: "南勢教會", lat: 24.170876, lng: 120.896805, photo: "assets/photos/zhongmiao/nanshi.jpg", showPhoto: true },
                    { name: "裡冷教會", lat: 24.164515, lng: 120.952551, photo: "assets/photos/zhongmiao/lileng.jpg", showPhoto: true },
                    { name: "博愛教會", lat: 24.174447, lng: 120.978225, photo: "assets/photos/zhongmiao/boai.jpg", showPhoto: true }
                ]
            },
            nantou: {
                name: "南投小區",
                id: "nantou",
                churches: [
                    { name: "翠巒教會", lat: 24.182960, lng: 121.204100, photo: "assets/photos/nantou/cuiluan.jpg", showPhoto: true },
                    { name: "力行教會", lat: 24.148459, lng: 121.190195, photo: "assets/photos/nantou/lixing.jpg", showPhoto: true },
                    { name: "紅香教會", lat: 24.159071, lng: 121.176026, photo: "assets/photos/nantou/hongxiang.jpg", showPhoto: true },
                    { name: "慈峰教會", lat: 24.131208, lng: 121.184243, photo: "assets/photos/nantou/cifeng.jpg", showPhoto: true },
                    { name: "精英教會", lat: 24.061304, lng: 121.194630, photo: "assets/photos/nantou/jingying.jpg", showPhoto: true },
                    { name: "廬山教會", lat: 24.033899, lng: 121.185267, photo: "assets/photos/nantou/lushan.jpg", showPhoto: true },
                    { name: "春陽教會", lat: 24.027045, lng: 121.149445, photo: "assets/photos/nantou/chunyang.jpg", showPhoto: true }
                ]
            }
        };

        let currentZoneId = 'fuxing';

        function initUI() {
            const btnContainer = document.getElementById('zone-buttons');
            btnContainer.innerHTML = '';
            
            // 建立切換按鈕
            Object.values(zonesData).forEach(zone => {
                const btn = document.createElement('button');
                btn.innerText = zone.name;
                btn.className = `px-6 py-2 rounded-full font-bold transition-colors ${currentZoneId === zone.id ? 'bg-brand-navy text-white ring-2 ring-brand-gold' : 'bg-gray-200 text-gray-600 hover:bg-gray-300'}`;
                btn.onclick = () => switchZone(zone.id);
                btnContainer.appendChild(btn);
            });
            
            renderPoster(currentZoneId);
        }

        function switchZone(zoneId) {
            currentZoneId = zoneId;
            initUI(); // 重新渲染按鈕狀態
        }

        function renderPoster(zoneId) {
            const data = zonesData[zoneId];
            
            // 更新標題與照片
            document.getElementById('display-zone-title').innerText = data.name;
            document.getElementById('display-zone-img').src = data.image;
            
            // 更新教會座標列表
            const listContainer = document.getElementById('display-zone-churches');
            listContainer.innerHTML = '';
            
            data.churches.forEach(church => {
                const item = document.createElement('div');
                item.className = 'flex flex-col border-b border-gray-600 pb-2';
                item.innerHTML = `
                    <span class="text-lg font-bold text-brand-light tracking-wide">${church.name}</span>
                    <span class="text-sm font-mono text-gray-400">📍 ${church.coord}</span>
                `;
                listContainer.appendChild(item);
            });
        }

        function downloadPoster() {
            const statusMsg = document.getElementById('status-msg');
            const data = zonesData[currentZoneId];
            
            // 顯示載入中，避免使用 alert 中斷
            statusMsg.classList.remove('hidden');
            statusMsg.innerText = `正在生成【${data.name}】海報，請稍候...`;

            const posterElement = document.getElementById('poster');
            
            html2canvas(posterElement, {
                scale: 2,
                useCORS: true, 
                backgroundColor: '#0B132B',
                logging: false
            }).then(canvas => {
                const image = canvas.toDataURL("image/png");
                
                const link = document.createElement('a');
                // 動態命名下載的檔案
                link.download = `TJC_百年音樂會_西區傳教史_${data.name}.png`;
                link.href = image;
                link.click();
                
                statusMsg.innerText = '✅ 下載完成！';
                setTimeout(() => statusMsg.classList.add('hidden'), 3000);
            }).catch(err => {
                console.error("生成圖片發生錯誤:", err);
                statusMsg.innerText = '❌ 生成圖片失敗，請檢查圖片路徑是否正確。';
                statusMsg.classList.add('bg-red-100', 'text-red-700');
            });
        }

        // 初始化
        window.onload = initUI;
    </script>
</body>
</html>
