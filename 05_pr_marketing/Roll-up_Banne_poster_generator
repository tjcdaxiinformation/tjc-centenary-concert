<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roll-up Banner Poster Generator</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <!-- 引入 html2canvas 供匯出圖片使用 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
        body {
            font-family: 'Noto Serif TC', serif;
            background-color: #1a1a2e;
            color: #fff;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: row; /* 改為左右排列：左控制面板，右預覽區 */
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* 隱藏捲軸但保留滾動功能 */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1a1a2e; 
        }
        ::-webkit-scrollbar-thumb {
            background: #4a5568; 
            border-radius: 4px;
        }

        /* 左側控制面板 */
        #control-panel {
            width: 350px;
            background-color: #162032;
            padding: 24px;
            height: 100vh;
            overflow-y: auto;
            box-shadow: 5px 0 15px rgba(0,0,0,0.5);
            position: fixed;
            left: 0;
            top: 0;
            z-index: 50;
        }

        /* 右側預覽區 (讓其可以滾動) */
        #preview-area {
            margin-left: 350px;
            width: calc(100% - 350px);
            display: flex;
            justify-content: center;
            padding: 40px 0;
            background-color: #0d131f;
        }

        #poster-container {
            width: 800px;
            height: 2000px; /* 1:2.5 易拉展比例 */
            background: linear-gradient(135deg, rgba(11,16,33,0.85) 0%, rgba(26,42,64,0.85) 50%, rgba(11,16,33,0.85) 100%), url('https://images.unsplash.com/photo-1507692049790-de58290a4334?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
            transform-origin: top center;
        }

        /* 垂直文字 */
        .vertical-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            letter-spacing: 0.5em;
        }

        /* 金色文字特效 */
        .gold-text {
            background: linear-gradient(to bottom, #FFDF73 0%, #D4AF37 50%, #996515 100%);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        /* 拖曳元素的樣式 */
        .draggable {
            position: absolute;
            cursor: grab;
            user-select: none;
            transition: box-shadow 0.2s;
        }
        .draggable:active {
            cursor: grabbing;
            box-shadow: 0 10px 25px rgba(0,0,0,0.8);
            z-index: 100;
        }

        /* SVG 箭頭覆蓋層 */
        .arrow-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none; /* 讓點擊穿透 */
            z-index: 20;
        }
    </style>
</head>
<body>

    <div id="control-panel" class="border-r border-slate-700">
        <h2 class="text-2xl font-bold mb-6 text-amber-500 border-b border-slate-600 pb-2">海報產生器控制台</h2>
        
        <div class="mb-5">
            <label class="block text-sm font-medium mb-1">小區名稱 / 標題</label>
            <input type="text" id="input-title" value="復興小區" class="w-full bg-slate-800 border border-slate-600 rounded px-3 py-2 text-white focus:outline-none focus:border-amber-500">
        </div>

        <div class="mb-5">
            <label class="block text-sm font-medium mb-1">上傳主視覺背景</label>
            <input type="file" id="upload-bg" accept="image/*" class="w-full text-sm text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-amber-600 file:text-white hover:file:bg-amber-700 cursor-pointer">
        </div>

        <div class="mb-5">
            <label class="block text-sm font-medium mb-1">上傳地圖底圖</label>
            <input type="file" id="upload-map" accept="image/*" class="w-full text-sm text-slate-300 file:mr-4 file:py-2 file:px-4 file:rounded file:border-0 file:text-sm file:font-semibold file:bg-emerald-600 file:text-white hover:file:bg-emerald-700 cursor-pointer">
        </div>

        <hr class="border-slate-600 my-6">

        <div class="mb-4">
            <button id="btn-add-photo" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mb-2 transition">
                + 新增老照片 (可拖曳)
            </button>
            <button id="btn-add-marker" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded transition">
                + 新增地圖圖釘 (可拖曳)
            </button>
        </div>

        <hr class="border-slate-600 my-6">

        <button id="btn-download" class="w-full bg-amber-500 hover:bg-amber-600 text-slate-900 font-black text-lg py-3 px-4 rounded shadow-lg transition transform hover:scale-105">
            匯出海報 (下載 JPG)
        </button>
        <p class="text-xs text-slate-400 mt-2">提示：直接在右側畫布上拖曳照片與圖釘來調整位置。</p>
    </div>

    <div id="preview-area">
        <div id="poster-container">
            <!-- 裝飾紋理 -->
            <div class="absolute inset-0 opacity-10 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] pointer-events-none z-0"></div>
            
            <!-- 中央垂直大標題 -->
            <div class="absolute inset-0 flex justify-center items-center pointer-events-none z-10 opacity-80">
                <h1 id="poster-district-title" class="vertical-text text-[140px] font-black gold-text opacity-40 ml-12 shadow-2xl drop-shadow-[0_0_15px_rgba(255,200,0,0.3)]">
                    復興小區
                </h1>
            </div>

            <!-- 右側地圖區域 -->
            <div id="map-area" class="absolute top-[300px] left-[450px] w-[300px] h-[1550px] rounded-3xl border border-amber-500/30 overflow-hidden shadow-[0_0_30px_rgba(0,0,0,0.5)] z-0">
                <!-- 地圖底圖 (預設為占位圖) -->
                <div id="map-bg" class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1524661135-423995f22d0b?q=80&w=1000&auto=format&fit=crop')] bg-cover bg-center opacity-70 mix-blend-lighten bg-slate-800"></div>
                <!-- 備用地形紋理 -->
                <div class="absolute inset-0 opacity-30" style="background-image: repeating-radial-gradient(circle at 50% 50%, transparent 0, rgba(212, 175, 55, 0.1) 15px), repeating-linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.2)); pointer-events: none;"></div>
            </div>

            <!-- 動態內容區 (放置拖曳的照片與圖釘) -->
            <div id="dynamic-content" class="absolute inset-0 z-30">
                <!-- 預設示範元素 (可拖曳) -->
                <div class="draggable p-2 bg-white rounded shadow-xl border border-slate-300" style="top: 400px; left: 100px; width: 250px;">
                    <img src="https://images.unsplash.com/photo-1517456793572-1d8efd6dc135?q=80&w=500&auto=format&fit=crop" class="w-full h-auto rounded" alt="歷史照片">
                    <p class="text-slate-800 font-bold text-center mt-2 text-lg">早期聚會所</p>
                </div>
                
                <div class="draggable" style="top: 800px; left: 580px;">
                    <div class="w-8 h-8 bg-red-500 rounded-full border-4 border-white shadow-lg flex items-center justify-center animate-bounce">
                        <div class="w-2 h-2 bg-white rounded-full"></div>
                    </div>
                </div>
            </div>

            <!-- SVG 連接線或裝飾層 -->
            <svg class="arrow-overlay" id="arrow-svg">
                <defs>
                    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                        <feGaussianBlur stdDeviation="5" result="blur" />
                        <feComposite in="SourceGraphic" in2="blur" operator="over" />
                    </filter>
                </defs>
                <g id="arrow-paths"></g>
            </svg>

            <!-- 右下角 QR Code -->
            <div class="absolute bottom-[90px] right-10 z-40 flex flex-col items-center bg-white/95 backdrop-blur p-3 rounded-2xl shadow-2xl border-2 border-amber-500/80">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=https://tjcdaxiinformation.github.io/tjc-centenary-concert/west_history.html" alt="西區傳教史 QR Code" class="w-28 h-28 mb-2 rounded-lg">
                <span class="text-slate-900 font-black tracking-widest text-sm">西區傳教史</span>
            </div>

            <!-- 底部文字 -->
            <div class="absolute bottom-8 w-full text-center text-amber-500/60 font-bold tracking-widest text-lg z-10">
                TRUE JESUS CHURCH 100TH ANNIVERSARY
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // DOM 元素參考
            const inputTitle = document.getElementById('input-title');
            const posterTitle = document.getElementById('poster-district-title');
            const uploadBg = document.getElementById('upload-bg');
            const posterContainer = document.getElementById('poster-container');
            const uploadMap = document.getElementById('upload-map');
            const mapBg = document.getElementById('map-bg');
            const btnAddPhoto = document.getElementById('btn-add-photo');
            const btnAddMarker = document.getElementById('btn-add-marker');
            const dynamicContent = document.getElementById('dynamic-content');
            const btnDownload = document.getElementById('btn-download');

            // 1. 即時更新標題
            inputTitle.addEventListener('input', (e) => {
                posterTitle.innerText = e.target.value || '請輸入標題';
            });

            // 2. 更換主視覺背景
            uploadBg.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        // 保留漸層並替換背景圖片
                        posterContainer.style.background = `linear-gradient(135deg, rgba(11,16,33,0.85) 0%, rgba(26,42,64,0.85) 50%, rgba(11,16,33,0.85) 100%), url('${event.target.result}')`;
                        posterContainer.style.backgroundSize = 'cover';
                        posterContainer.style.backgroundPosition = 'center';
                    };
                    reader.readAsDataURL(file);
                }
            });

            // 3. 更換地圖底圖
            uploadMap.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        mapBg.style.backgroundImage = `url('${event.target.result}')`;
                    };
                    reader.readAsDataURL(file);
                }
            });

            let activeDragElement = null;
            let offsetX = 0;
            let offsetY = 0;

            function makeDraggable(element) {
                element.addEventListener('mousedown', (e) => {
                    activeDragElement = element;
                    // 計算滑鼠相對於元素左上角的偏移量
                    const rect = element.getBoundingClientRect();
                    const containerRect = posterContainer.getBoundingClientRect();
                    
                    // 為了在縮放的容器中保持精確，計算相對於 posterContainer 的位置
                    offsetX = e.clientX - rect.left;
                    offsetY = e.clientY - rect.top;
                    
                    element.style.zIndex = 1000; // 拖曳時置頂
                });
            }

            // 初始化既有的拖曳元素
            document.querySelectorAll('.draggable').forEach(makeDraggable);

            // 處理全局鼠標移動與釋放
            document.addEventListener('mousemove', (e) => {
                if (!activeDragElement) return;

                const containerRect = posterContainer.getBoundingClientRect();
                
                // 確保元素被限制在海報容器內
                let newX = e.clientX - containerRect.left - offsetX;
                let newY = e.clientY - containerRect.top - offsetY;

                activeDragElement.style.left = `${newX}px`;
                activeDragElement.style.top = `${newY}px`;
            });

            document.addEventListener('mouseup', () => {
                if (activeDragElement) {
                    activeDragElement.style.zIndex = ''; // 恢復預設
                    activeDragElement = null;
                }
            });

            // 4. 新增照片
            btnAddPhoto.addEventListener('click', () => {
                const el = document.createElement('div');
                el.className = 'draggable p-2 bg-white rounded shadow-xl border border-slate-300';
                el.style.top = '500px';
                el.style.left = '150px';
                el.style.width = '250px';
                
                el.innerHTML = `
                    <div class="relative group">
                        <img src="https://placehold.co/500x350/e2e8f0/475569?text=Photo" class="w-full h-auto rounded" alt="新照片">
                        <button class="absolute top-1 right-1 bg-red-500 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 delete-btn cursor-pointer">✕</button>
                    </div>
                    <input type="text" value="輸入描述文字" class="w-full mt-2 text-slate-800 font-bold text-center text-lg border-b border-dashed border-slate-400 focus:outline-none">
                `;
                
                // 加入刪除功能
                el.querySelector('.delete-btn').addEventListener('click', (e) => {
                    e.stopPropagation(); // 防止觸發拖曳
                    el.remove();
                });

                dynamicContent.appendChild(el);
                makeDraggable(el);
            });

            // 5. 新增標記點
            btnAddMarker.addEventListener('click', () => {
                const el = document.createElement('div');
                el.className = 'draggable group';
                el.style.top = '800px';
                el.style.left = '600px';
                
                el.innerHTML = `
                    <div class="w-8 h-8 bg-amber-500 rounded-full border-4 border-white shadow-lg flex items-center justify-center">
                        <div class="w-2 h-2 bg-white rounded-full"></div>
                    </div>
                    <button class="absolute -top-6 -right-6 bg-red-500 text-white rounded-full w-5 h-5 flex items-center justify-center opacity-0 group-hover:opacity-100 delete-btn cursor-pointer text-xs">✕</button>
                `;

                // 加入刪除功能
                el.querySelector('.delete-btn').addEventListener('click', (e) => {
                    e.stopPropagation();
                    el.remove();
                });

                dynamicContent.appendChild(el);
                makeDraggable(el);
            });

            // 6. 匯出海報 (透過 html2canvas)
            btnDownload.addEventListener('click', () => {
                btnDownload.innerText = "處理中...";
                btnDownload.disabled = true;

                // 為了避免截圖時控制項(如刪除按鈕、輸入框框)出現，可以稍微處理，但這裡保持簡單直出
                html2canvas(posterContainer, {
                    scale: 1, // 控制輸出解析度，設 1 維持 800x2000
                    useCORS: true, // 允許跨域圖片 (若圖片來自外部需伺服器設定)
                    backgroundColor: '#1a1a2e'
                }).then(canvas => {
                    const link = document.createElement('a');
                    link.download = `${inputTitle.value || 'poster'}-banner.jpg`;
                    link.href = canvas.toDataURL('image/jpeg', 0.9);
                    link.click();

                    btnDownload.innerText = "匯出海報 (下載 JPG)";
                    btnDownload.disabled = false;
                }).catch(err => {
                    console.error("匯出錯誤:", err);
                    alert("匯出失敗，請確認是否使用了不允許跨域的外部圖片。");
                    btnDownload.innerText = "匯出海報 (下載 JPG)";
                    btnDownload.disabled = false;
                });
            });
        });
    </script>
</body>
</html>
